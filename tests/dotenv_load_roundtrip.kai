import dotenv

import os.env

fn fail(message: String) : Int / Stderr {
  Stderr.eprint("#{message}\n")
  1
}

fn cleanup(path: String) : Unit / File + Env {
  let _ = file_delete(path)
  let _ = env.unset("KAI_DOTENV_NAME")
  let _ = env.unset("KAI_DOTENV_URL")
  ()
}

fn main() : Int / File + Env + Stderr {
  let path = "/tmp/kai_dotenv_load_roundtrip.env"
  cleanup(path)
  let _ = write_file(path, "KAI_DOTENV_NAME=file\nKAI_DOTENV_URL=https://${KAI_DOTENV_NAME}.test\n")
  let _ = env.set("KAI_DOTENV_NAME", "process")
  let preserved = dotenv.load_files([path], dotenv.options())
  if preserved != Ok(Report { files: [path], loaded: ["KAI_DOTENV_URL"], preserved: ["KAI_DOTENV_NAME"] }) {
    cleanup(path)
    fail("preserving load report differed")
  } else if env.get("KAI_DOTENV_NAME") != Some("process") {
    cleanup(path)
    fail("existing value was overwritten")
  } else {
    let overwritten = dotenv.load_files([path], dotenv.options() |> dotenv.with_overwrite)
    let required = dotenv.require_keys(["KAI_DOTENV_NAME", "KAI_DOTENV_URL"])
    let name = env.get("KAI_DOTENV_NAME")
    cleanup(path)
    if (overwritten == Ok(Report { files: [path], loaded: ["KAI_DOTENV_NAME", "KAI_DOTENV_URL"], preserved: [] })) and ((required == Ok(())) and (name == Some("file"))) {
      0
    } else {
      fail("overwriting load differed")
    }
  }
}
