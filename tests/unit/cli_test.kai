import ahu.cli

fn noop(_context: cli.Context) : Result[Unit, String] = Ok(())

fn configured_app[e]() : cli.App[e] = cli.app("forge", "Build useful things") |> cli.versioned("1.2.3") |> cli.add_command(cli.command("build", "Build one target", noop) |> cli.command_alias("b") |> cli.with_argument(cli.required_argument("TARGET", "Target to build.")) |> cli.with_argument(cli.repeated_argument("FILES", "Input files.")) |> cli.with_option(cli.text_option_with_default("profile", "Build profile.", "debug") |> cli.short("p")) |> cli.with_option(cli.integer_option("jobs", "Worker count.") |> cli.short("j")) |> cli.with_option(cli.boolean_option("force", "Overwrite existing output.") |> cli.short("f")) |> cli.with_option(cli.text_list_option("tag", "Attach a tag.")))

test "resolves command aliases, typed options, repeated options and positionals" {
  let result = cli.resolve(configured_app(), ["b", "site", "a.kai", "b.kai", "-p", "release", "--jobs=4", "--force", "--tag", "one", "--tag=two"])
  assert match result {
    Ok(Invoke(_, context)) -> ((((((cli.command_name(context) == "build") and (cli.argument(context, "TARGET") == Some("site"))) and (cli.arguments(context, "FILES") == ["a.kai", "b.kai"])) and (cli.text(context, "profile") == Some("release"))) and (cli.integer(context, "jobs") == Some(4))) and cli.boolean(context, "force")) and (cli.texts(context, "tag") == ["one", "two"])
    _ -> false
  }
}

test "tracks whether a defaulted option was explicitly supplied" {
  let result = cli.resolve(configured_app(), ["build", "site"])
  assert match result {
    Ok(Invoke(_, context)) -> ((cli.text(context, "profile") == Some("debug")) and (not cli.option_present(context, "profile"))) and (not cli.boolean(context, "force"))
    _ -> false
  }
}

test "supports boolean negation and the option terminator" {
  let result = cli.resolve(configured_app(), ["build", "site", "--force", "--no-force", "--", "-literal"])
  assert match result {
    Err(error) -> cli.error_message(error) == "option `--force` may only be supplied once"
    _ -> false
  }
}

test "the option terminator preserves dash-prefixed positional values" {
  let result = cli.resolve(configured_app(), ["build", "site", "--", "-literal"])
  assert match result {
    Ok(Invoke(_, context)) -> cli.arguments(context, "FILES") == ["-literal"]
    _ -> false
  }
}

test "reports missing arguments and malformed typed options" {
  let missing = cli.resolve(configured_app(), ["build"])
  let malformed = cli.resolve(configured_app(), ["build", "site", "--jobs", "many"])
  assert match missing {
    Err(error) -> cli.error_message(error) == "required argument `TARGET` is missing"
    _ -> false
  }
  assert match malformed {
    Err(error) -> cli.error_message(error) == "option `--jobs` expects an integer, got `many`"
    _ -> false
  }
}

test "resolves application, command and version help without running handlers" {
  assert match cli.resolve(configured_app(), ["--help"]) {
    Ok(ApplicationHelp) -> true
    _ -> false
  }
  assert match cli.resolve(configured_app(), ["help", "build"]) {
    Ok(CommandHelp(_)) -> true
    _ -> false
  }
  assert match cli.resolve(configured_app(), ["--version"]) {
    Ok(ApplicationVersion("1.2.3")) -> true
    _ -> false
  }
}

test "renders deterministic self-documenting help" {
  let application_help = cli.render_help(configured_app())
  let command_help = match cli.resolve(configured_app(), ["help", "build"]) {
    Ok(CommandHelp(command)) -> cli.render_command_help(configured_app(), command)
    _ -> panic("expected command help")
  }
  assert string.index_of(application_help, "forge <command> [options]") != None
  assert string.index_of(application_help, "build <TARGET> [FILES...]") != None
  assert string.index_of(command_help, "--profile <TEXT>") != None
  assert string.index_of(command_help, "Default: debug.") != None
}

test "rejects conflicting command and option declarations" {
  let duplicate_commands = cli.app("bad", "bad") |> cli.add_command(cli.command("one", "one", noop) |> cli.command_alias("shared")) |> cli.add_command(cli.command("two", "two", noop) |> cli.command_alias("shared"))
  let duplicate_options = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.text_option("name", "first")) |> cli.with_option(cli.text_option("name", "second")))
  assert match cli.resolve(duplicate_commands, []) {
    Err(error) -> cli.error_message(error) == "invalid application: duplicate command name or alias `shared`"
    _ -> false
  }
  assert match cli.resolve(duplicate_options, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: duplicate option `--name`"
    _ -> false
  }
}

test "a default command handles argv without an explicit command name" {
  let application = cli.app("echo", "echo") |> cli.add_command(cli.command("say", "say", noop) |> cli.with_argument(cli.optional_argument("TEXT", "text"))) |> cli.default_command("say")
  assert match cli.resolve(application, ["hello"]) {
    Ok(Invoke(_, context)) -> cli.argument(context, "TEXT") == Some("hello")
    _ -> false
  }
  assert match cli.resolve(application, []) {
    Ok(Invoke(_, context)) -> cli.argument(context, "TEXT") == None
    _ -> false
  }
}

fn failing(_context: cli.Context) : Result[Unit, String] = Err("work failed")

fn silently(application: cli.App[Stdout], argv: [String]) : Int = handle {
  handle {
    cli.run_argv(application, argv)
  } with Stdout {
    print(_message, resume) -> resume(())
    is_tty(resume) -> resume(false)
  }
} with Stderr {
  eprint(_message, resume) -> resume(())
  is_tty(resume) -> resume(false)
}

fn exit_code(argv: [String]) : Int = silently(cli.app("tool", "demo") |> cli.versioned("1.0.0") |> cli.add_command(cli.command("run", "Runs.", failing) |> cli.with_option(cli.integer_option("jobs", "Worker count."))), argv)

test "usage errors exit with 2 and command failures with 1" {
  assert exit_code(["run", "--nope"]) == 2
  assert exit_code(["nope"]) == 2
  assert exit_code(["run", "--jobs"]) == 2
  assert exit_code(["run", "--jobs", "many"]) == 2
  assert exit_code(["run", "extra"]) == 2
  assert exit_code(["run"]) == 1
}

test "successful help and version exit with 0" {
  assert exit_code(["--help"]) == 0
  assert exit_code(["help", "run"]) == 0
  assert exit_code(["--version"]) == 0
}

test "an invalid application definition exits with 1" {
  let duplicate = cli.app("bad", "bad") |> cli.add_command(cli.command("one", "one", failing)) |> cli.add_command(cli.command("one", "again", failing))
  assert silently(duplicate, ["one"]) == 1
}

test "the usage exit code is configurable within 1..255" {
  let base = cli.app("tool", "demo") |> cli.add_command(cli.command("run", "Runs.", failing))
  assert silently(base |> cli.usage_exit_code(64), ["nope"]) == 64
  assert silently(base |> cli.usage_exit_code(64), ["run"]) == 1
  assert silently(base |> cli.usage_exit_code(0), ["nope"]) == 1
  assert silently(base |> cli.usage_exit_code(256), ["nope"]) == 1
  assert match cli.resolve(base |> cli.usage_exit_code(0), []) {
    Err(error) -> cli.error_message(error) == "invalid application: usage exit code `0` is outside 1..255"
    _ -> false
  }
}

test "-V prints the version and -v is not reserved" {
  assert match cli.resolve(configured_app(), ["-V"]) {
    Ok(ApplicationVersion("1.2.3")) -> true
    _ -> false
  }
  assert match cli.resolve(configured_app(), ["-v"]) {
    Ok(ApplicationVersion(_)) -> false
    _ -> true
  }
  assert string.index_of(cli.render_help(configured_app()), "-V, --version") != None
  assert string.index_of(cli.render_help(configured_app()), "-v, --version") == None
}

test "a command may use -v for its own verbose flag" {
  let application = cli.app("tool", "demo") |> cli.versioned("1.0.0") |> cli.add_command(cli.command("loc", "Counts.", noop) |> cli.with_option(cli.boolean_option("verbose", "Verbose output.") |> cli.short("v")))
  assert match cli.resolve(application, ["loc", "-v"]) {
    Ok(Invoke(_, context)) -> cli.boolean(context, "verbose")
    _ -> false
  }
}

fn loc_app() : cli.App[Stdout] = cli.app("km", "demo") |> cli.add_command(cli.command("loc", "Counts.", noop) |> cli.with_option(cli.text_option_with_default("format", "Output format.", "table") |> cli.choices(["table", "json"]) |> cli.short("f")) |> cli.with_option(cli.text_list_option("kind", "Kinds to count.") |> cli.choices(["code", "comment"])) |> cli.with_option(cli.text_list_option("include-ext", "Extensions to include.") |> cli.conflicts_with("exclude-ext")) |> cli.with_option(cli.text_list_option("exclude-ext", "Extensions to exclude.")))

fn loc_error(argv: [String]) : String = match cli.resolve(loc_app(), ["loc", ...argv]) {
  Err(error) -> cli.error_message(error)
  Ok(_) -> "ok"
}

test "choices accept listed values and reject others, long, short and inline" {
  assert loc_error(["--format", "json"]) == "ok"
  assert loc_error(["--format=json", "--kind", "code", "--kind", "comment"]) == "ok"
  assert loc_error([]) == "ok"
  assert loc_error(["--format", "nope"]) == "option `--format` expects one of table, json, got `nope`"
  assert loc_error(["--format=nope"]) == "option `--format` expects one of table, json, got `nope`"
  assert loc_error(["-f", "nope"]) == "option `-f` expects one of table, json, got `nope`"
  assert loc_error(["--kind", "code", "--kind", "nope"]) == "option `--kind` expects one of code, comment, got `nope`"
}

test "conflicting options are rejected only when both are supplied" {
  assert loc_error(["--include-ext", "kai"]) == "ok"
  assert loc_error(["--exclude-ext", "kai"]) == "ok"
  assert loc_error(["--include-ext", "kai", "--exclude-ext", "md"]) == "options `--include-ext` and `--exclude-ext` cannot be used together"
  assert loc_error(["--exclude-ext", "md", "--include-ext", "kai"]) == "options `--include-ext` and `--exclude-ext` cannot be used together"
}

test "choices and conflicts are listed in help on both sides of a conflict" {
  let help = match cli.resolve(loc_app(), ["help", "loc"]) {
    Ok(CommandHelp(command)) -> cli.render_command_help(loc_app(), command)
    _ -> panic("expected command help")
  }
  assert string.index_of(help, "Choices: table, json. Default: table.") != None
  assert string.index_of(help, "Extensions to include. Conflicts with --exclude-ext.") != None
  assert string.index_of(help, "Extensions to exclude. Conflicts with --include-ext.") != None
}

test "invalid choices and conflicts are usage errors with the usage exit code" {
  assert silently(loc_app(), ["loc", "--format", "nope"]) == 2
  assert silently(loc_app(), ["loc", "--include-ext", "a", "--exclude-ext", "b"]) == 2
}

test "rejects inconsistent choices and conflict declarations" {
  let bad_kind = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.integer_option("jobs", "jobs") |> cli.choices(["1"])))
  let bad_default = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.text_option_with_default("mode", "mode", "x") |> cli.choices(["a"])))
  let unknown = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.boolean_option("a", "a") |> cli.conflicts_with("b")))
  let itself = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.boolean_option("a", "a") |> cli.conflicts_with("a")))
  assert match cli.resolve(bad_kind, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: option `--jobs` cannot have choices: only text options can"
    _ -> false
  }
  assert match cli.resolve(bad_default, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: the default of option `--mode` is not one of its choices"
    _ -> false
  }
  assert match cli.resolve(unknown, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: option `--a` conflicts with unknown option `--b`"
    _ -> false
  }
  assert match cli.resolve(itself, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: option `--a` cannot conflict with itself"
    _ -> false
  }
}

fn kinds_app() : cli.App[Stdout] = cli.app("km", "demo") |> cli.add_command(cli.command("loc", "Counts.", noop) |> cli.with_option(cli.text_list_option("kind", "Kinds to count.") |> cli.choices(["code", "docs", "all"]) |> cli.value_delimiter(",")) |> cli.with_option(cli.text_list_option("path", "Paths.") |> cli.value_delimiter(":")) |> cli.with_option(cli.text_list_option("tag", "Tags.")))

fn kinds(argv: [String]) : Result[[String], String] = match cli.resolve(kinds_app(), ["loc", ...argv]) {
  Ok(Invoke(_, context)) -> Ok(cli.texts(context, "kind"))
  Ok(_) -> Err("not an invocation")
  Err(error) -> Err(cli.error_message(error))
}

test "a value delimiter splits each occurrence and keeps the order" {
  assert kinds(["--kind", "code,docs"]) == Ok(["code", "docs"])
  assert kinds(["--kind=docs", "--kind", "code,all"]) == Ok(["docs", "code", "all"])
  assert kinds(["--kind", "code"]) == Ok(["code"])
  assert kinds([]) == Ok([])
  assert match cli.resolve(kinds_app(), ["loc", "--path", "a:b", "--tag", "x,y"]) {
    Ok(Invoke(_, context)) -> (cli.texts(context, "path") == ["a", "b"]) and (cli.texts(context, "tag") == ["x,y"])
    _ -> false
  }
}

test "choices apply to each delimited element" {
  assert kinds(["--kind", "code,nope"]) == Err("option `--kind` expects one of code, docs, all, got `nope`")
  assert kinds(["--kind", "code,"]) == Err("option `--kind` expects one of code, docs, all, got ``")
  assert silently(kinds_app(), ["loc", "--kind", "code,nope"]) == 2
}

test "help says an option accepts delimited values" {
  let help = match cli.resolve(kinds_app(), ["help", "loc"]) {
    Ok(CommandHelp(command)) -> cli.render_command_help(kinds_app(), command)
    _ -> panic("expected command help")
  }
  assert string.index_of(help, "Kinds to count. Choices: code, docs, all. Values may be separated by `,`.") != None
  assert string.index_of(help, "Tags.\n") != None
}

test "rejects a value delimiter on a scalar option or an empty one" {
  let scalar = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.text_option("mode", "mode") |> cli.value_delimiter(",")))
  let empty = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.text_list_option("tag", "tag") |> cli.value_delimiter("")))
  assert match cli.resolve(scalar, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: option `--mode` cannot have a value delimiter: only repeatable text options can"
    _ -> false
  }
  assert match cli.resolve(empty, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: the value delimiter of option `--tag` is empty"
    _ -> false
  }
}
