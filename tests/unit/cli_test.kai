import ahu.cli

fn noop(_context: cli.Context) : Result[Unit, String] = Ok(())

fn configured_app[e]() : cli.App[e] = cli.app("forge", "Build useful things") |> cli.versioned("1.2.3") |> cli.add_command(cli.command("build", "Build one target", noop) |> cli.command_alias("b") |> cli.with_argument(cli.required_argument("TARGET", "Target to build.")) |> cli.with_argument(cli.repeated_argument("FILES", "Input files.")) |> cli.with_option(cli.text_option_with_default("profile", "Build profile.", "debug") |> cli.short("p")) |> cli.with_option(cli.integer_option("jobs", "Worker count.") |> cli.short("j")) |> cli.with_option(cli.boolean_option("force", "Overwrite existing output.") |> cli.short("f")) |> cli.with_option(cli.text_list_option("tag", "Attach a tag.")))

test "resolves command aliases, typed options, repeated options and positionals" {
  let result = cli.resolve(configured_app(), ["b", "site", "a.kai", "b.kai", "-p", "release", "--jobs=4", "--force", "--tag", "one", "--tag=two"])
  assert match result {
    Ok(Invoke(_, context)) -> ((((((cli.command_name(context) == "build") and (cli.argument(context, "TARGET") == Some("site"))) and (cli.arguments(context, "FILES") == ["a.kai", "b.kai"])) and (cli.text(context, "profile") == Some("release"))) and (cli.integer(context, "jobs") == Some(4))) and cli.boolean(context, "force")) and (cli.texts(context, "tag") == ["one", "two"])
    _ -> false
  }
}

test "tracks whether a defaulted option was explicitly supplied" {
  let result = cli.resolve(configured_app(), ["build", "site"])
  assert match result {
    Ok(Invoke(_, context)) -> ((cli.text(context, "profile") == Some("debug")) and (not cli.option_present(context, "profile"))) and (not cli.boolean(context, "force"))
    _ -> false
  }
}

test "supports boolean negation and the option terminator" {
  let result = cli.resolve(configured_app(), ["build", "site", "--force", "--no-force", "--", "-literal"])
  assert match result {
    Err(error) -> cli.error_message(error) == "option `--force` may only be supplied once"
    _ -> false
  }
}

test "the option terminator preserves dash-prefixed positional values" {
  let result = cli.resolve(configured_app(), ["build", "site", "--", "-literal"])
  assert match result {
    Ok(Invoke(_, context)) -> cli.arguments(context, "FILES") == ["-literal"]
    _ -> false
  }
}

test "reports missing arguments and malformed typed options" {
  let missing = cli.resolve(configured_app(), ["build"])
  let malformed = cli.resolve(configured_app(), ["build", "site", "--jobs", "many"])
  assert match missing {
    Err(error) -> cli.error_message(error) == "required argument `TARGET` is missing"
    _ -> false
  }
  assert match malformed {
    Err(error) -> cli.error_message(error) == "option `--jobs` expects an integer, got `many`"
    _ -> false
  }
}

test "resolves application, command and version help without running handlers" {
  assert match cli.resolve(configured_app(), ["--help"]) {
    Ok(ApplicationHelp) -> true
    _ -> false
  }
  assert match cli.resolve(configured_app(), ["help", "build"]) {
    Ok(CommandHelp(_)) -> true
    _ -> false
  }
  assert match cli.resolve(configured_app(), ["--version"]) {
    Ok(ApplicationVersion("1.2.3")) -> true
    _ -> false
  }
}

test "renders deterministic self-documenting help" {
  let application_help = cli.render_help(configured_app())
  let command_help = match cli.resolve(configured_app(), ["help", "build"]) {
    Ok(CommandHelp(command)) -> cli.render_command_help(configured_app(), command)
    _ -> panic("expected command help")
  }
  assert string.index_of(application_help, "forge <command> [options]") != None
  assert string.index_of(application_help, "build <TARGET> [FILES...]") != None
  assert string.index_of(command_help, "--profile <TEXT>") != None
  assert string.index_of(command_help, "Default: debug.") != None
}

test "rejects conflicting command and option declarations" {
  let duplicate_commands = cli.app("bad", "bad") |> cli.add_command(cli.command("one", "one", noop) |> cli.command_alias("shared")) |> cli.add_command(cli.command("two", "two", noop) |> cli.command_alias("shared"))
  let duplicate_options = cli.app("bad", "bad") |> cli.add_command(cli.command("run", "run", noop) |> cli.with_option(cli.text_option("name", "first")) |> cli.with_option(cli.text_option("name", "second")))
  assert match cli.resolve(duplicate_commands, []) {
    Err(error) -> cli.error_message(error) == "invalid application: duplicate command name or alias `shared`"
    _ -> false
  }
  assert match cli.resolve(duplicate_options, []) {
    Err(error) -> cli.error_message(error) == "invalid application: command `run`: duplicate option `--name`"
    _ -> false
  }
}

test "a default command handles argv without an explicit command name" {
  let application = cli.app("echo", "echo") |> cli.add_command(cli.command("say", "say", noop) |> cli.with_argument(cli.optional_argument("TEXT", "text"))) |> cli.default_command("say")
  assert match cli.resolve(application, ["hello"]) {
    Ok(Invoke(_, context)) -> cli.argument(context, "TEXT") == Some("hello")
    _ -> false
  }
  assert match cli.resolve(application, []) {
    Ok(Invoke(_, context)) -> cli.argument(context, "TEXT") == None
    _ -> false
  }
}
