#[doc("High-level helpers for materializing, enqueuing and executing background jobs.")]

import encoding.json

import encoding.json_bind.{JsonValue}

import time

import ahu.jobs.adapter as jobs_api_adapter

import ahu.jobs.execution as jobs_api_execution

import ahu.jobs.job as jobs_api_job

#[doc("A materialized job paired with backend acceptance evidence.")]
pub type Enqueued = { job: jobs_api_job.Job, receipt: jobs_api_adapter.Receipt }

#[doc("A recoverable materialization or adapter failure.")]
pub type EnqueueError
  = InvalidJob(jobs_api_job.JobError)
  | QueueFailure(jobs_api_adapter.AdapterError)

#[doc("Materializes and submits a validated job specification.")]
pub fn perform_later(value: jobs_api_job.Spec) : Result[Enqueued, EnqueueError] / Clock + SecureRandom + QueueAdapter = match jobs_api_job.materialize(value) {
  Err(error) -> Err(InvalidJob(error))
  Ok(materialized) -> match jobs_api_adapter.submit(materialized) {
    Err(error) -> Err(QueueFailure(error))
    Ok(receipt) -> Ok(Enqueued { job: materialized, receipt: receipt })
  }
}

#[doc("Schedules for an absolute wall time, then materializes and submits.")]
pub fn perform_at(value: jobs_api_job.Spec, at: time.WallTime) : Result[Enqueued, EnqueueError] / Clock + SecureRandom + QueueAdapter = perform_later(jobs_api_job.wait_until(value, at))

#[doc("Schedules relative to now, then materializes and submits.")]
pub fn perform_in(value: jobs_api_job.Spec, delay: time.Duration) : Result[Enqueued, EnqueueError] / Clock + SecureRandom + QueueAdapter = match jobs_api_job.wait_for(value, delay, time.now()) {
  Err(error) -> Err(InvalidJob(error))
  Ok(delayed) -> perform_later(delayed)
}

#[doc("Materializes and executes a specification immediately without a queue adapter.")]
pub fn perform_now[e](value: jobs_api_job.Spec, dispatch: (String, [JsonValue]) -> Result[Unit, String] / e) : Result[jobs_api_execution.Record, jobs_api_job.JobError] / Clock + SecureRandom + e = match jobs_api_job.materialize(value) {
  Ok(materialized) -> Ok(jobs_api_execution.perform(materialized, dispatch))
  Err(error) -> Err(error)
}

#[doc("Executes an already materialized job through an explicit dispatcher.")]
pub fn execute[e](value: jobs_api_job.Job, dispatch: (String, [JsonValue]) -> Result[Unit, String] / e) : jobs_api_execution.Record / e = jobs_api_execution.perform(value, dispatch)
