import ahu.cli

fn greet(context: cli.Context) : Result[Unit, String] / Stdout = match cli.argument(context, "NAME") {
  None -> Err("missing NAME")
  Some(name) -> {
    let greeting = option.unwrap_or(cli.text(context, "greeting"), "Hello")
    let message = "#{greeting}, #{name}!"
    Stdout.print(if cli.boolean(context, "loud") {
      "#{message |> to_upper()}\n"
    } else {
      "#{message}\n"
    })
    Ok(())
  }
}

fn main() : Int / Env + Stdout + Stderr {
  let application = cli.app("greeter", "A small ahu.cli example") |> cli.versioned("0.1.0") |> cli.add_command(cli.command("greet", "Greet one person", greet) |> cli.command_alias("hello") |> cli.with_argument(cli.required_argument("NAME", "Person to greet.")) |> cli.with_option(cli.text_option("greeting", "Words placed before the name.") |> cli.short("g") |> cli.value_name("WORDS")) |> cli.with_option(cli.boolean_option("loud", "Print the greeting in uppercase.") |> cli.short("l")))
  cli.run(application)
}
